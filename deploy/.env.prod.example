# Copy to .env.prod on the server and fill in. Never commit the real file.

# Public address, e.g. documorph.duckdns.org
DOMAIN=

# Generate each with:  openssl rand -base64 48
DOCUMORPH_DB_PASSWORD=
DOCUMORPH_JWT_SECRET=
PIPELINE_API_KEY=

# From `modal token new`, or Modal dashboard -> Settings -> API Tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
