# Production build. Unlike Dockerfile, this one does not copy a pre-downloaded
# Gradle distribution: a server can fetch it normally, and gradle-cache/ is
# not in the repository, so a fresh clone could not build with Dockerfile.
FROM eclipse-temurin:23-jdk AS build
WORKDIR /app
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./
RUN chmod +x gradlew && ./gradlew --no-daemon --version
COPY src src
RUN ./gradlew bootJar --no-daemon

FROM eclipse-temurin:23-jre
WORKDIR /app
COPY --from=build /app/build/libs/documorph-backend-0.0.1-SNAPSHOT.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
